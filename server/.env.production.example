# -----------------------------------------------------------------------
# This is NOT read by the app - it's a checklist for what to set in
# Vercel → your SERVER project → Settings → Environment Variables (Production).
#
# server/.env (the one with localhost values) is only used for local dev
# and is gitignored - it is never deployed. Vercel builds purely from
# whatever you set in its dashboard, so if these aren't set there,
# the server silently falls back to localhost URLs, which is exactly
# what caused payments to redirect to localhost after a successful charge.
# -----------------------------------------------------------------------

# Your deployed CLIENT (frontend) URL - no trailing slash
CLIENT_URL=https://your-client-app.vercel.app

# This SERVER's own deployed URL - no trailing slash (needed for eSewa's
# success/failure callback URLs, which eSewa calls directly)
SERVER_URL=https://your-server-app.vercel.app

NODE_ENV=production

# Plus every other var already in server/.env (DATABASE_URL, CLERK keys,
# STRIPE keys, ESEWA keys, RESEND keys, etc.) with production/live values
# where applicable.
