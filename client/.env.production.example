# -----------------------------------------------------------------------
# This is NOT read by the app - it's a checklist for what to set in
# Vercel → your CLIENT project → Settings → Environment Variables (Production).
#
# client/.env (with VITE_BASEURL=http://localhost:3000) is only used for
# local dev and is gitignored. Vite bakes VITE_* vars into the built JS at
# BUILD time, so if this isn't set in Vercel, the deployed site's build
# still points at localhost - this is what caused the mobile "network
# error", since there's no local server on your phone to answer that call.
# -----------------------------------------------------------------------

VITE_CURRENCY='$'
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YnJpZ2h0LW1vbmtleS00Mi5jbGVyay5hY2NvdW50cy5kZXYk

# Your deployed SERVER (backend) URL - no trailing slash
VITE_BASEURL=https://your-server-app.vercel.app

# After setting/changing this, you MUST trigger a new deployment
# (Redeploy in Vercel, or push a commit) - env var changes don't apply
# to builds that already ran.
